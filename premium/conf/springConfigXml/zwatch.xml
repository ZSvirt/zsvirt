            <zstack:extension interface="org.zstack.header.apimediator.GlobalApiMessageInterceptor"/>
        </zstack:plugin>
    </bean>


    <bean id="EmailTextTemplateFactory" class="org.zstack.zwatch.alarm.sns.template.email.EmailTextTemplateFactory" >
