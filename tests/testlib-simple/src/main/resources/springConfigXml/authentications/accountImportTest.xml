<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zstack="http://zstack.org/schema/zstack"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
         http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
         http://zstack.org/schema/zstack
         http://zstack.org/schema/zstack/plugin.xsd"
       default-init-method="init" default-destroy-method="destroy">

    <!--
      Do NOT name this file accountImport.xml: a same-path resource would shadow
      conf/springConfigXml/authentications/accountImport.xml and force test to copy every new production bean.

      Imported after authentications/accountImport.xml: overrides the bean definition so by-type lookup
      and the already-registered plugin extensions resolve to the Simulator instance.
    -->
    <bean id="AccountSourceSyncingExtensions" primary="true"
          class="org.zstack.testlib.identity.ldap.AccountSourceSyncingExtensionsSimulator">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.Component"/>
            <zstack:extension interface="org.zstack.identity.imports.source.CreateAccountSourceExtensionPoint"/>
            <zstack:extension interface="org.zstack.header.managementnode.ManagementNodeReadyExtensionPoint"/>
        </zstack:plugin>
    </bean>
</beans>
