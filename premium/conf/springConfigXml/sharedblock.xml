        <zstack:plugin>
            <zstack:extension interface="org.zstack.ha.HaHostChecker" />
        </zstack:plugin>
    </bean>-->

    <bean id="ShareBlockHostHeartbeatChecker" class="org.zstack.storage.primary.shareblock.ShareBlockHostHeartbeatChecker" >
        <zstack:plugin>
            <zstack:extension interface="org.zstack.ha.HaHostChecker" />
        </zstack:plugin>
    </bean>

    <bean id="SharedBlockManagerImpl" class="org.zstack.storage.primary.sharedblock.SharedBlockManagerImpl">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.Component" />
            <zstack:extension interface="org.zstack.header.Service" />
            <zstack:extension interface="org.zstack.header.storage.primary.PrimaryStorageDiscoverExtensionPoint" />
        </zstack:plugin>
    </bean>

    <bean id="SharedBlockPreallocationFactory" class="org.zstack.storage.primary.sharedblock.SharedBlockPreallocationFactory">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.storage.primary.preallocation.PreallocationFactory" />
        </zstack:plugin>
    </bean>

    <bean id="SharedBlockVolumeFactory"  class="org.zstack.storage.primary.sharedblock.SharedBlockVolumeFactory">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.volume.CreateDataVolumeExtensionPoint"/>
        </zstack:plugin>
    </bean>
    <bean id="SharedBlockVmMetadataExtension" class="org.zstack.storage.primary.sharedblock.SharedBlockVmMetadataExtension">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.vm.metadata.VmMetadataPathBuildExtensionPoint" />
            <zstack:extension interface="org.zstack.header.vm.metadata.VmMetadataPathReplacementExtensionPoint" />
        </zstack:plugin>
    </bean>

</beans>
