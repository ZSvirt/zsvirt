        </zstack:plugin>
        <property name="changeVmPasswdFlowElements">
            <list>
                <value>org.zstack.compute.vm.ChangeVmPasswordFlow</value>
            </list>
        </property>
        <property name="changeVmImageFlowElements">
            <list>
                <value>org.zstack.compute.vm.VmImageSelectBackupStorageFlow</value>
                <value>org.zstack.compute.vm.VmAllocateHostFlow</value>
                <value>org.zstack.compute.vm.VmAllocatePrimaryStorageFlow</value>
                <value>org.zstack.compute.vm.VmAllocateVolumeFlow</value>
                <value>org.zstack.compute.vm.VmInstantiateResourceForChangeImageFlow</value>
                <value>org.zstack.compute.vm.ChangeVmImageFlow</value>
            </list>
        </property>
    </bean>

