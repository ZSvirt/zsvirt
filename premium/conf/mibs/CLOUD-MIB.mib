    ::= { clusterAlarmObjects 3 }

alarmDuration OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the duration of alarm"
    ::= { clusterAlarmObjects 4 }

alarmPreviousStatus OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the previous status of alarm"
    ::= { clusterAlarmObjects 5 }

alarmCurrentMetricValue OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the current metric value of alarm"
    ::= { clusterAlarmObjects 6 }

alarmResourceUuid OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the resource uuid of alarm"
    ::= { clusterAlarmObjects 7 }

alarmResourceName OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the resource name of alarm"
    ::= { clusterAlarmObjects 8 }

alarmEmergencyLevel OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the emergency level of alarm"
    ::= { clusterAlarmObjects 9 }

alarmLabels OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the labels of alarm"
    ::= { clusterAlarmObjects 10 }

alarmTriggerTime OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the trigger time of alarm"
    ::= { clusterAlarmObjects 11 }

clusterAlarm NOTIFICATION-TYPE
    OBJECTS {
        alarmUuid,
        alarmResourceType,
        alarmCondition,
        alarmDuration,
        alarmPreviousStatus,
        alarmCurrentMetricValue,
        alarmResourceUuid,
        alarmResourceName,
        alarmEmergencyLevel,
        alarmLabels,
        alarmTriggerTime
    }
    STATUS  current
    DESCRIPTION
        "cloud alarm notification object"
    ::= { clusterAlertPrefix 1 }

eventName OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the name of event"
    ::= { clusterEventObjects 1 }

eventResourceType OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the resource type of event"
    ::= { clusterEventObjects 2 }

eventEmergencyLevel OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the emergency level of event"
    ::= { clusterEventObjects 3 }

eventResourceUuid OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the resource uuid of event"
    ::= { clusterEventObjects 4 }

eventResourceName OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the resource name of event"
    ::= { clusterEventObjects 5 }

eventTriggerTime OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the trigger time of event"
    ::= { clusterEventObjects 6 }

eventSubscriptionUuid OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the subscription uuid of event"
    ::= { clusterEventObjects 7 }

eventLabels OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the labels of event"
    ::= { clusterEventObjects 8 }

eventError OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS accessible-for-notify
    STATUS     current
    DESCRIPTION
        "the error of event"
    ::= { clusterEventObjects 9 }

clusterEvent NOTIFICATION-TYPE
    OBJECTS {
        eventName,
        eventResourceType,
        eventEmergencyLevel,
        eventResourceUuid,
        eventResourceName,
        eventTriggerTime,
        eventSubscriptionUuid,
        eventLabels,
        eventError
    }
    STATUS  current
    DESCRIPTION
        "cloud event notification object"
    ::= { clusterAlertPrefix 2 }

-- 1.3.6.1.4.1.60687.1.1.102
primaryStorage OBJECT IDENTIFIER ::= { cloud 102 }

-- 1.3.6.1.4.1.60687.1.1.102.1
primaryStorageTable OBJECT-TYPE
    SYNTAX     SEQUENCE OF PrimaryStorageEntry
    MAX-ACCESS not-accessible
    STATUS     current
    DESCRIPTION
        "A table of primary storage in the cloud"
    ::= { primaryStorage 1 }

-- 1.3.6.1.4.1.60687.1.1.102.1.1
primaryStorageEntry OBJECT-TYPE
    SYNTAX     PrimaryStorageEntry
    MAX-ACCESS not-accessible
    STATUS     current
    DESCRIPTION
        "A row describing a primary storage"
    ::= { primaryStorageTable 1 }

PrimaryStorageEntry ::= SEQUENCE {
