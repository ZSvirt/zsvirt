<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:zstack="http://zstack.org/schema/zstack"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
         http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
         http://zstack.org/schema/zstack
         http://zstack.org/schema/zstack/plugin.xsd"
       default-init-method="init" default-destroy-method="destroy">

    <bean id="TelemetryManager" class="org.zstack.zsv.telemetry.TelemetryManager">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.Component"/>
            <zstack:extension interface="org.zstack.header.Service"/>
        </zstack:plugin>
    </bean>

    <bean id="TelemetryApiInterceptor" class="org.zstack.zsv.telemetry.TelemetryApiInterceptor">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.apimediator.ApiMessageInterceptor"/>
        </zstack:plugin>
    </bean>

    <bean id="TelemetryGlobalConfigApiInterceptor" class="org.zstack.zsv.telemetry.TelemetryGlobalConfigApiInterceptor">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.apimediator.GlobalApiMessageInterceptor"/>
        </zstack:plugin>
    </bean>

    <bean id="TelemetryGlobalConfigInitExtensions" class="org.zstack.zsv.telemetry.config.TelemetryGlobalConfigInitExtensions">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.managementnode.ManagementNodeReadyExtensionPoint"/>
        </zstack:plugin>
    </bean>

    <bean id="TelemetryConsentGlobalConfigExtensions" class="org.zstack.zsv.telemetry.config.TelemetryConsentGlobalConfigExtensions">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.Component"/>
        </zstack:plugin>
    </bean>

    <bean id="TelemetryAnonymizer" class="org.zstack.zsv.telemetry.privacy.TelemetryAnonymizer"/>

    <bean id="TelemetryLicenseTypeProvider" class="org.zstack.zsv.telemetry.license.DummyTelemetryLicenseTypeProvider"/>

    <bean id="TelemetryCollector" class="org.zstack.zsv.telemetry.collect.TelemetryCollector">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.Component"/>
        </zstack:plugin>
    </bean>

    <bean id="TelemetryTaskScheduler" class="org.zstack.zsv.telemetry.TelemetryTaskScheduler">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.Component"/>
            <zstack:extension interface="org.zstack.header.managementnode.ManagementNodeReadyExtensionPoint"/>
        </zstack:plugin>
    </bean>

</beans>
