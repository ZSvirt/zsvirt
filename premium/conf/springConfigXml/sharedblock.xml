    <bean id="SharedBlockGroupPrimaryStorageImageCacheCleaner" class="org.zstack.storage.primary.sharedblock.SharedBlockGroupPrimaryStorageImageCacheCleaner">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.managementnode.ManagementNodeReadyExtensionPoint" order="99"/>
        </zstack:plugin>
    </bean>

    <bean id="SharedBlockApiInterceptor" class="org.zstack.storage.primary.sharedblock.SharedBlockApiInterceptor">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.apimediator.ApiMessageInterceptor" />
            <zstack:extension interface="org.zstack.header.apimediator.GlobalApiMessageInterceptor" />
        </zstack:plugin>
    </bean>

    <!--bean id="SharedBlockKvmFactory" class="org.zstack.storage.primary.sharedblock.SharedBlockKvmFactory">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.storage.primary.sharedblock.SharedBlockHypervisorFactory" />
            <zstack:extension interface="org.zstack.kvm.KVMHostConnectExtensionPoint" />
        </zstack:plugin>
    </bean-->

    <bean id="ImageStoreBackupStorageSharedBlockKvmFactory" class="org.zstack.storage.primary.sharedblock.ImageStoreBackupStorageKvmFactory">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.storage.primary.sharedblock.BackupStorageSharedBlockKvmFactory" />
        </zstack:plugin>
    </bean>

    <bean id="SftpBackupStorageSharedBlockKvmFactory" class="org.zstack.storage.primary.sharedblock.SftpBackupStorageKvmFactory">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.storage.primary.sharedblock.BackupStorageSharedBlockKvmFactory" />
        </zstack:plugin>
    </bean>

    <bean id="SharedBlockImageStoreKvmFactory"  class="org.zstack.storage.primary.sharedblock.SharedBlockImageStoreKvmFactory">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.storage.primary.sharedblock.SharedBlockHypervisorFactory" />
            <zstack:extension interface="org.zstack.kvm.KVMHostConnectExtensionPoint" />
            <zstack:extension interface="org.zstack.kvm.KVMPingAgentNoFailureExtensionPoint"/>
            <zstack:extension interface="org.zstack.header.host.HostAfterMaintenanceExtensionPoint" />
            <zstack:extension interface="org.zstack.kvm.KVMStartVmExtensionPoint"/>
        </zstack:plugin>
    </bean>

    <bean id="SharedBlockImageStoreFactory" class="org.zstack.storage.primary.sharedblock.SharedBlockImageStoreFactory">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.Component"/>
            <zstack:extension interface="org.zstack.header.storage.primary.PrimaryStorageFactory" />
            <zstack:extension interface="org.zstack.header.storage.snapshot.CreateTemplateFromVolumeSnapshotExtensionPoint" />
            <zstack:extension interface="org.zstack.header.host.HostDeleteExtensionPoint" order="-1" />
            <zstack:extension interface="org.zstack.header.storage.primary.PrimaryStorageDetachExtensionPoint" />
            <zstack:extension interface="org.zstack.storage.snapshot.PostMarkRootVolumeAsSnapshotExtension"/>
            <zstack:extension interface="org.zstack.header.storage.primary.PrimaryStorageAttachExtensionPoint"/>
            <zstack:extension interface="org.zstack.kvm.KVMStartVmExtensionPoint"/>
            <zstack:extension interface="org.zstack.kvm.KVMAttachVolumeExtensionPoint"/>
            <zstack:extension interface="org.zstack.kvm.KVMDetachVolumeExtensionPoint"/>
            <zstack:extension interface="org.zstack.kvm.KVMConvertVolumeExtensionPoint" />
            <zstack:extension interface="org.zstack.kvm.KVMMergeSnapshotExtensionPoint"/>
            <zstack:extension interface="org.zstack.kvm.KVMTakeSnapshotExtensionPoint" order="-1"/>
            <zstack:extension interface="org.zstack.kvm.KVMBlockCommitExtensionPoint" order="-1"/>
            <zstack:extension interface="org.zstack.kvm.KVMBlockPullExtensionPoint" order="-1"/>
            <zstack:extension interface="org.zstack.header.host.HostResizeVolumeExtensionPoint" order="-1"/>
            <zstack:extension interface="org.zstack.kvm.KvmSetupSelfFencerExtensionPoint" />
            <zstack:extension interface="org.zstack.header.storageDevice.GetScsiLunCandidatesExtensionPoint" />
            <zstack:extension interface="org.zstack.kvm.KVMCheckSnapshotExtensionPoint" order="-1"/>
        </zstack:plugin>
    </bean>

    <bean id="SharedBlockAgentDeployer" class="org.zstack.storage.primary.sharedblock.SharedBlockAgentDeployer">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.kvm.KVMHostConnectExtensionPoint" />
            <zstack:extension interface="org.zstack.header.Component" />
        </zstack:plugin>
    </bean>

    <bean id="SharedBlockKvmBackend" class="org.zstack.storage.primary.sharedblock.SharedBlockKvmBackend">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.storage.primary.PrimaryStorage" />
            <zstack:extension interface="org.zstack.header.vm.VmInstanceMigrateExtensionPoint" />
            <zstack:extension interface="org.zstack.storage.migration.VolumeMigrateExtensionPoint"/>
            <zstack:extension interface="org.zstack.header.vm.PreVmInstantiateResourceExtensionPoint" order="-1" />
            <zstack:extension interface="org.zstack.header.vm.VmReleaseResourceExtensionPoint" order="-1" />
            <zstack:extension interface="org.zstack.header.vm.ChangeVmImageExtensionPoint" order="-1"/>
            <zstack:extension interface="org.zstack.header.vm.VmAttachVolumeExtensionPoint" order="-1" />
            <zstack:extension interface="org.zstack.header.vm.VmDetachVolumeExtensionPoint" order="-1" />
            <zstack:extension interface="org.zstack.kvm.KVMTakeSnapshotExtensionPoint" />
            <zstack:extension interface="org.zstack.kvm.KVMPreAttachIsoExtensionPoint" />
            <zstack:extension interface="org.zstack.kvm.KVMBlockCommitExtensionPoint" />
            <zstack:extension interface="org.zstack.kvm.KVMBlockPullExtensionPoint" />
            <zstack:extension interface="org.zstack.header.storage.snapshot.VolumeSnapshotBeforeDeleteExtensionPoint" />
            <zstack:extension interface="org.zstack.header.volume.ResizeVolumeExtensionPoint"/>
            <zstack:extension interface="org.zstack.header.storage.snapshot.BeforeTakeLiveSnapshotsOnVolumes"/>
            <zstack:extension interface="org.zstack.header.storage.snapshot.VolumeSnapshotCreationExtensionPoint"/>
            <zstack:extension interface="org.zstack.header.storage.snapshot.VolumeSnapshotDeletionProtector" />
            <zstack:extension interface="org.zstack.header.Component" />
        </zstack:plugin>
    </bean>

    <bean id="SblkToSblkMigrateVolumeChainFactory" class="org.zstack.storage.primary.sharedblock.migration.SblkToSblkMigrateVolumeChainFactory">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.header.Component" />
            <zstack:extension interface="org.zstack.storage.migration.StorageMigrationChainFactory"/>
        </zstack:plugin>
        <property name="flowClassNames">
            <list>
                <value>org.zstack.storage.migration.primary.ReserveCapacityFromDstPSFlow</value>
                <value>org.zstack.storage.primary.sharedblock.migration.SblkToSblkMigrateVolumeFlow</value>
                <value>org.zstack.storage.migration.primary.UpdateVolumeVOFlow</value>
                <value>org.zstack.storage.migration.primary.DiscardVolumeReferenceFlow</value>
                <value>org.zstack.storage.primary.sharedblock.migration.SblkToSblkDiscardSourceVolumeFlow</value>
            </list>
        </property>
        <property name="rollbackFlowClassNames">
            <list>
                <value>org.zstack.storage.primary.sharedblock.migration.SblkToSblkRollbackMigrateVolumeFlow</value>
            </list>
        </property>
        <property name="discardClassNames">
            <list>
                <value>org.zstack.storage.migration.primary.DiscardVolumeReferenceFlow</value>
                <value>org.zstack.storage.primary.sharedblock.migration.SblkToSblkDiscardSourceVolumeFlow</value>
            </list>
        </property>
        <property name="cancelFlowClassNames">
            <list>
                <value>org.zstack.storage.primary.sharedblock.migration.SblkToSblkCancelMigrateVolumeFlow</value>
            </list>
        </property>
    </bean>

