    <bean id="PubIpVmNicBandwidthBillingGenerator" class="org.zstack.billing.generator.pubip.vmnic.PubIpVmNicBandwidthBillingGenerator">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.billing.generator.BillingGenerator" />
        </zstack:plugin>
    </bean>

    <bean id="PubIpVmNicBandwidthBillingSpendingCalculator" class="org.zstack.billing.generator.pubip.vmnic.PubIpVmNicBandwidthBillingSpendingCalculator">
        <zstack:plugin>
            <zstack:extension interface="org.zstack.billing.generator.BillingSpendingCalculator" />
        </zstack:plugin>
