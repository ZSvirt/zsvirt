-- ----------------------------------------------------
-- CLOUD-MIB.MIB
--
-- This file defines MIB objects for Cloud module
-- ----------------------------------------------------
CLOUD-MIB DEFINITIONS ::= BEGIN

IMPORTS
    MODULE-IDENTITY,
    NOTIFICATION-TYPE,
    OBJECT-TYPE,
    Counter32,
    Gauge32,
    IpAddress,
    Integer32,
    Unsigned32
        FROM SNMPv2-SMI
    DisplayString
        FROM SNMPv2-TC
    enterprises
        FROM SNMPv2-SMI;

-- 1.3.6.1.4.1.60687
zstack MODULE-IDENTITY
    LAST-UPDATED "202512170000Z"
    ORGANIZATION "www.zstack.io"
    CONTACT-INFO "software@zstack.io"
    DESCRIPTION
    "MIB objects for Cloud"
    REVISION   "202512170000Z"
    DESCRIPTION
    "Added Info labels"
    REVISION   "202308110000Z"
    DESCRIPTION
    "Initial version"
    ::= { enterprises 60687 }



--
-- defines IDENTIFIER of Cloud
--

-- 1.3.6.1.4.1.60687.1
products        OBJECT IDENTIFIER ::= { zstack 1 }
-- 1.3.6.1.4.1.60687.1.1
cloud             OBJECT IDENTIFIER ::= { products 1 }
-- 1.3.6.1.4.1.60687.1.2
alerts   OBJECT IDENTIFIER ::= { cloud 1 }

clusterAlertPrefix  OBJECT IDENTIFIER ::= { alerts 0 }
clusterAlarmObjects OBJECT IDENTIFIER ::= { alerts 1 }
clusterEventObjects OBJECT IDENTIFIER ::= { alerts 2 }

-- 1.3.6.1.4.1.60687.1.1.101
kvmHost OBJECT IDENTIFIER ::= { cloud 101 }

--
-- ZStack/kvmHost Table
--
-- 1.3.6.1.4.1.60687.1.1.101.101
kvmHostTable OBJECT-TYPE
    SYNTAX     SEQUENCE OF KVMHostEntry
    MAX-ACCESS not-accessible
    STATUS     current
    DESCRIPTION
        "A table of KVM hosts in cloud"
    ::= { kvmHost 101 }

-- 1.3.6.1.4.1.60687.1.1.101.1
kvmHostEntry OBJECT-TYPE
    SYNTAX     KVMHostEntry
    MAX-ACCESS not-accessible
    STATUS     current
    DESCRIPTION
        "A row describing a kvm host"
    ::= { kvmHostTable 1 }

KVMHostEntry ::= SEQUENCE {
    uuid                            DisplayString,
    name                            DisplayString,
    managementIp                    DisplayString,
    cpuAllIdleUtilization           DisplayString,
    cpuAllUsedUtilization           DisplayString,
    cpuAverageIdleUtilization       DisplayString,
    cpuAverageSystemUtilization     DisplayString,
    cpuAverageUsedUtilization       DisplayString,
    cpuAverageUserUtilization       DisplayString,
    cpuAverageWaitUtilization       DisplayString,
    diskAllFreeCapacityInBytes      DisplayString,
    diskAllFreeCapacityInPercent    DisplayString,
    diskAllReadBytes                DisplayString,
    diskAllReadOps                  DisplayString,
    diskAllUsedCapacityInBytes      DisplayString,
    diskAllUsedCapacityInPercent    DisplayString,
    diskAllWriteBytes               DisplayString,
    diskAllWriteOps                 DisplayString,
    diskRootUsedCapacityInBytes     DisplayString,
    diskRootUsedCapacityInPercent   DisplayString,
    diskTotalCapacityInBytes        DisplayString,
    diskTransUsedCapacityInBytes    DisplayString,
    diskTransUsedCapacityInPercent  DisplayString,
    diskZStackUsedCapacityInBytes   DisplayString,
    diskZStackUsedCapacityInPercent DisplayString,
    ipmiStatus                      DisplayString,
    memoryFreeBytes                 DisplayString,
    memoryFreeInPercent             DisplayString,
    memoryUsedBytes                 DisplayString,
    memoryUsedInPercent             DisplayString,
    networkAllInBytes               DisplayString,
    networkAllInErrors              DisplayString,
    networkAllInPackets             DisplayString,
    networkAllOutBytes              DisplayString,
    networkAllOutErrors             DisplayString,
    networkAllOutPackets            DisplayString,
    networkConntrackCount           DisplayString,
    networkConntrackInPercent       DisplayString
}

uuid OBJECT-TYPE
    SYNTAX     DisplayString
    MAX-ACCESS read-only
    STATUS     current
    DESCRIPTION
        "the uuid of kvmhost"
    ::= { kvmHostEntry 0 }

name OBJECT-TYPE
