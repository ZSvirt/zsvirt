        </zstack:plugin>
        <property name="createVmFromVolumeWorkFlowElements">
            <list>
                <value>org.zstack.compute.vm.CheckIfCreateTemporaryTemplateFlow</value>
                <value>org.zstack.compute.vm.CreateTemplateFromVolumeFlow</value>
                <value>org.zstack.compute.vm.CreateVmFromTemplateFlow</value>
                <value>org.zstack.compute.vm.DeleteTemplateFlow</value>
            </list>
        </property>
        <property name="createVmFromSnapshotWorkFlowElements">
            <list>
                <value>org.zstack.compute.vm.CheckIfCreateTemporaryTemplateFlow</value>
                <value>org.zstack.compute.vm.CreateRootTemplateFromVolumeSnapshotFlow</value>
                <value>org.zstack.compute.vm.CreateVmFromTemplateFlow</value>
                <value>org.zstack.compute.vm.DeleteTemplateFlow</value>
            </list>
        </property>
        <property name="createVmFromSnapshotGroupWorkFlowElements">
            <list>
                <value>org.zstack.compute.vm.CheckDataVolumeLocationFlow</value>
                <value>org.zstack.compute.vm.CheckIfCreateTemporaryTemplateFlow</value>
                <value>org.zstack.compute.vm.CreateRootTemplateFromVolumeSnapshotFlow</value>
                <value>org.zstack.compute.vm.CreateDataVolumeFromVolumeSnapshotGroupFlow</value>
                <value>org.zstack.compute.vm.CreateVmFromTemplateFlow</value>
                <value>org.zstack.compute.vm.AttachDataVolumeInOrderFlow</value>
                <value>org.zstack.compute.vm.StartVmInstanceFlow</value>
                <value>org.zstack.compute.vm.DeleteTemplateFlow</value>
            </list>
        </property>
